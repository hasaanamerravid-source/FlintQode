# Keep text files LF in the working tree on every platform. Prettier is
# configured with endOfLine: "lf"; without this, a default Windows checkout
# (core.autocrlf=true) gives every file CRLF and the format gate fails with
# "Code style issues found in 110 files" even though the committed files are LF.
* text=auto eol=lf

# Binary assets must never be normalized. text=auto usually detects these, but
# listing them makes the intent explicit for icon and image files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
