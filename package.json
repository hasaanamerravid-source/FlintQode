{
  "name": "flintqode",
  "version": "1.4.5",
  "description": "FlintQode - a fast, native all-in-one text editor",
  "author": "FlintQode",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:app": "tauri dev",
    "build": "vite build",
    "build:app": "tauri build",
    "preview": "vite preview",
    "start": "tauri dev",
    "tauri": "tauri",
    "sync:version": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs && git diff --exit-code -- VERSION package.json src-tauri/Cargo.toml src-tauri/tauri.conf.json",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "test:unit": "node --import ./scripts/register-ts.mjs --test tests/*.test.mts",
    "icons": "tauri icon src-tauri/icons/icon-source.png",
    "i18n:check": "node scripts/i18n.mjs check",
    "i18n:coverage": "node scripts/i18n.mjs coverage",
    "i18n:template": "node scripts/i18n.mjs template",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.{mjs,js}\" \"tests/*.mts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/*.{mjs,js}\" \"tests/*.mts\"",
    "check": "npm run format:check && npm run typecheck && npm run i18n:check && npm run test:unit && npm run build"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "^3.0.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.27.0",
    "prettier": "^3.9.10",
    "rolldown": "~1.2.14",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@solidjs/web": "^2.0.3",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "solid-js": "^2.0.3"
  }
}
